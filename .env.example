# Copy to .env for local development. Every value below is a throwaway local default.
# Never commit .env. Never put real secrets or live payment keys here.

POSTGRES_ADMIN_PASSWORD=gatepass_admin_dev
PG_CATALOG_PASSWORD=catalog_dev
PG_BOOKING_PASSWORD=booking_dev
PG_SEAT_INVENTORY_PASSWORD=seat_inventory_dev
PG_PAYMENT_PASSWORD=payment_dev
PG_TICKET_PASSWORD=ticket_dev
PG_NOTIFICATION_PASSWORD=notification_dev
PG_ANALYTICS_PASSWORD=analytics_dev

TOPIC_PARTITIONS=3

# Host-side addresses (compose publishes these ports)
KAFKA_BROKERS=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081
REDIS_URL=redis://localhost:16379
