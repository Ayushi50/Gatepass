# Copy to .env for local development. Every value is a throwaway local default.
# Never commit .env. Never put real secrets or live payment keys here.

# Shared
KAFKA_BROKERS=localhost:19092

# catalog (port 3001), seat-inventory (3002), booking (3003): each has its OWN database.
# Example, one Postgres server with one database and role per service:
#   catalog:        DATABASE_URL=postgres://catalog:catalog_dev@localhost:5432/catalog
#   seat-inventory: DATABASE_URL=postgres://seat_inventory:seat_inventory_dev@localhost:5432/seat_inventory
#   booking:        DATABASE_URL=postgres://booking:booking_dev@localhost:5432/booking
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# seat-inventory: how long seats are held while the buyer pays (ms). Default 10 minutes.
HOLD_TTL_MS=600000
# seat-inventory sweeper: how often to look for expired holds, and the extra grace after expiry
HOLD_SWEEP_INTERVAL_MS=1000
HOLD_GRACE_MS=60000

# payment (port 3004). TEST MODE ONLY. Never put live keys here.
PAYMENT_PROVIDER=fake
FAKE_WEBHOOK_SECRET=change-me-fake-webhook-secret
# FAKE_AUTO_WEBHOOK_MS=1500      # dev: fake provider delivers its own webhook after this delay
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ticket (port 3005): QR signing keys, "kid:secret,kid2:secret2". The FIRST key signs; all verify.
# Secrets must be 32+ characters. To rotate, put the new key first and keep the old one until old tickets expire.
TICKET_SIGNING_KEYS=k1:change-me-to-a-random-string-of-32-or-more-characters

# notification (no port, consumer only) and analytics (port 3007) need only DATABASE_URL and KAFKA_BROKERS.

# gateway (port 3000). Redis is used for the waiting room.
REDIS_URL=redis://localhost:6379
WAITING_ROOM_ADMIT_PER_SECOND=5
WAITING_ROOM_ADMISSION_TTL_SECONDS=300
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
CATALOG_URL=http://localhost:3001
SEAT_INVENTORY_URL=http://localhost:3002
BOOKING_URL=http://localhost:3003
PAYMENT_URL=http://localhost:3004
TICKET_URL=http://localhost:3005
ANALYTICS_URL=http://localhost:3007
