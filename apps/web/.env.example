# Where the Next server proxies /api to (the gateway).
GATEWAY_URL=http://127.0.0.1:3000
# Display timezone for show times (the design shows IST).
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
# "fake": the card/UPI form picks a test token for the fake payment provider. A real provider's
# own checkout would replace this; no card number ever leaves the browser either way.
NEXT_PUBLIC_PAYMENT_MODE=fake
