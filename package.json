{
  "name": "gatepass",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "pnpm --filter @gatepass/events generate",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm generate && jest --selectProjects unit",
    "schema:lint": "pnpm --filter @gatepass/events lint",
    "schema:breaking": "pnpm --filter @gatepass/events breaking",
    "replay": "ts-node --transpile-only libs/messaging/bin/replay.ts",
    "chaos:real": "ts-node --transpile-only tests/chaos/real/run.ts"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
