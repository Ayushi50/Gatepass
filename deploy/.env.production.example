# Copy to deploy/.env.production (git-ignored) and fill in the YOU FILL section.
# Format: KEY=value, one per line, NO quotes, NO spaces around "=".
# 05-render-env.sh reads this file plus deploy/secrets/secrets.env and writes one env file per
# process to /etc/gatepass/<name>.env. Nothing here is ever committed.

# ───────────────────────── YOU FILL ─────────────────────────
# Public domain (A record -> this server). No scheme, no trailing slash.
DOMAIN=gatepass.example.com

# Google sign-in: OAuth client of type "Web application".
# Authorized redirect URI to register: https://<DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Comma-separated Google emails (no spaces). Everyone else who signs in is an attendee.
ORGANIZER_EMAILS=you@example.com
DOOR_STAFF_EMAILS=

# Razorpay TEST mode only. Live keys (rzp_live_...) are refused by the code and by 05-render-env.sh.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-test-key-secret
# Make this with: openssl rand -hex 32   and paste the SAME value into the Razorpay webhook form.
RAZORPAY_WEBHOOK_SECRET=paste-output-of-openssl-rand-hex-32

# ───────────────────────── OPTIONAL TUNING (defaults shown) ─────────────────────────
HOLD_TTL_MS=600000
HOLD_SWEEP_INTERVAL_MS=1000
HOLD_GRACE_MS=60000
WAITING_ROOM_ADMIT_PER_SECOND=5
WAITING_ROOM_ADMISSION_TTL_SECONDS=300
# The gateway sees most visitors as one address (traffic arrives via the web app / Caddy), so the
# per-address limits are shared. Generous for a demo:
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_SIGNINS_PER_MINUTE=200
# Baked into the web build (a change needs 06-build.sh again):
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_HOLD_SECONDS=600
# Heap cap per Node process, MB (9 processes share a 4 GB box):
NODE_HEAP_MB=320

# ───────────────────────── GENERATED, DO NOT FILL ─────────────────────────
# These come from deploy/secrets/secrets.env (made by 02-secrets.sh). Listed so every variable
# the system reads is documented in one place.
#   KAFKA_BROKERS=127.0.0.1:9092                              all services
#   DATABASE_URL=postgres://<svc>:<generated>@127.0.0.1:5432/<svc>   catalog, seat-inventory, booking, payment, ticket, notification, analytics
#   PORT                                                      3000 gateway, 3001 catalog, 3002 seat-inventory, 3003 booking, 3004 payment, 3005 ticket, 3007 analytics, 3100 web
#   METRICS_PORT=3006                                         notification
#   PAYMENT_PROVIDER=razorpay                                 payment, gateway
#   TICKET_SIGNING_KEYS=k1:<generated, 64 hex>               ticket
#   JWT_SECRET=<generated, 64 hex>                            gateway
#   REDIS_URL=redis://127.0.0.1:6379                          gateway
#   CATALOG_URL SEAT_INVENTORY_URL BOOKING_URL PAYMENT_URL TICKET_URL ANALYTICS_URL   gateway -> http://127.0.0.1:<port>
#   GOOGLE_REDIRECT_URI=https://<DOMAIN>/api/auth/google/callback   gateway
#   GATEWAY_URL=http://127.0.0.1:3000                         web (build time)
#   NODE_ENV=production                                       every process
# Deliberately NOT set: ENABLE_DEV_LOGIN (demo sign-in stays off), FAKE_* (the fake payment provider
# refuses to run in production), OTEL_EXPORTER_OTLP_ENDPOINT (no tracing in this deployment).
